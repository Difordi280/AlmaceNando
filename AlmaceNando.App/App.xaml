<Application x:Class="AlmaceNando.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#2D5A27"/>
            <Color x:Key="PrimaryColor">#2D5A27</Color>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#FF8C00"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#E63946"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#EEEEEE"/>

            <Style x:Key="CardShadow" TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#EEEEEE" Opacity="0.5"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>