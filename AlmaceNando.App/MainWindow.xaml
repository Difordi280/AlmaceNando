<hc:Window x:Class="AlmaceNando.App.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="AlmaceNando" Height="750" Width="1280"
           WindowStartupLocation="CenterScreen"
           NonClientAreaBackground="{DynamicResource PrimaryDarkBrush}"
           NonClientAreaForeground="White">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkBrush}" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,12,0">
                        <TextBlock Text="A" FontWeight="ExtraBold" Foreground="White" FontSize="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SISTEMA" Foreground="#A5D6A7" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="ALMACENANDO" Foreground="White" FontWeight="Bold" FontSize="18" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding InjectedModules}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton 
                                Content="{Binding ViewName}" 
                                Style="{StaticResource MenuRadioButtonStyle}" 
                                IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UserNameDisplay, FallbackValue='Invitado'}" 
                                   Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UserRol}" Foreground="#81C784" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Command="{Binding HandleAuthActionCommand}" 
                            Padding="0" BorderThickness="0" Background="Transparent"
                            hc:BorderElement.CornerRadius="20" Cursor="Hand">
                        <Button.Content>
                            <Grid>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#33FFFFFF">
                                    <TextBlock Text="{Binding UserInitial, FallbackValue='?'}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               Foreground="White" 
                                               FontWeight="Bold" 
                                               FontSize="16"/>
                                </Border>
                                <Border Width="12" Height="12" 
                                        Background="#4CAF50" 
                                        BorderBrush="{DynamicResource PrimaryDarkBrush}" 
                                        BorderThickness="2" 
                                        CornerRadius="6" 
                                        VerticalAlignment="Bottom" 
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding AuthActionText}" 
                                          Command="{Binding HandleAuthActionCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="20"/>
    </Grid>
</hc:Window>