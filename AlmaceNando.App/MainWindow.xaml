<hc:Window x:Class="AlmaceNando.App.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="AlmaceNando" Height="700" Width="1200"
           WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="5" Padding="5" Margin="0,0,10,0">
                        <TextBlock Text="S" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" FontSize="18"/>
                    </Border>
                    <TextBlock Text="SISTEMA SUPERMERCADO" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton Content="Dashboard" Style="{StaticResource RadioButtonIcon}" Foreground="White" Margin="10,0"/>
                    <RadioButton Content="Ventas" Style="{StaticResource RadioButtonIcon}" IsChecked="True" Foreground="White" Margin="10,0"/>
                    <RadioButton Content="Reportes" Style="{StaticResource RadioButtonIcon}" Foreground="White" Margin="10,0"/>
                    <RadioButton Content="Clientes" Style="{StaticResource RadioButtonIcon}" Foreground="White" Margin="10,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="10"/>

    </Grid>
</hc:Window>
