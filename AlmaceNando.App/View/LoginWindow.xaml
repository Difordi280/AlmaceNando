<Window x:Class="AlmaceNando.App.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:AlmaceNando.App.View"
        Title="Inicio de Sesión" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <hc:SimplePanel>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="ALMACENANDO" 
                       Style="{StaticResource TextBlockTitleBold}" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <hc:TextBox hc:InfoElement.Placeholder="Nombre de usuario" 
                        hc:InfoElement.Title="Usuario"
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource TextBoxExtend}"
                        Margin="0,0,0,15"/>

            <PasswordBox x:Name="TxtPassword"
                         hc:InfoElement.Placeholder="Introduce tu contraseña" 
                         hc:InfoElement.Title="Contraseña"
                         Style="{StaticResource PasswordBoxExtend}"
                         Margin="0,0,0,25"/>

            <Button Content="Iniciar Sesión" 
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=TxtPassword}"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Stretch" 
                    Height="40"/>

            <TextBlock Text="{Binding ErrorMessager}" 
                       Foreground="Red" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </StackPanel>
    </hc:SimplePanel>
</Window>
