
    
    <hc:Window x:Class="AlmaceNando.App.View.LogoutWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Cierre de Turno" Height="680" Width="460"
           WindowStartupLocation="CenterScreen"
           Background="{StaticResource BackgroundBrush}"
           NonClientAreaBackground="{StaticResource PrimaryDarkBrush}"
           NonClientAreaForeground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" CornerRadius="0,0,25,25">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="RESUMEN DE CIERRE" 
                           Foreground="White" FontSize="22" FontWeight="ExtraBold" 
                           />
                <TextBlock Text="Corte de caja y control de fianzas" 
                           Foreground="#A5D6A7" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,-20,20,10">
            <StackPanel>
                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="EFECTIVO EN CAJA" FontWeight="Bold" FontSize="12" 
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                        <hc:TextBox Text="{Binding PhysicalCash, UpdateSourceTrigger=PropertyChanged}" 
                                    hc:InfoElement.Placeholder="0.00"
                                    FontSize="28" FontWeight="Black" 
                                    Style="{StaticResource TextBoxExtend}"
                                    hc:BorderElement.CornerRadius="10"
                                    BorderThickness="2"
                                    HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#F5F5F5" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <hc:PasswordBox x:Name="SuperPin" 
                        hc:InfoElement.Placeholder="PIN SUPERVISOR" 
                        hc:InfoElement.ShowClearButton="True"
                        Margin="0,0,10,0" 
                        hc:BorderElement.CornerRadius="8"/>

                        <Button Grid.Column="1" 
                Content="REVELAR" 
                Style="{StaticResource ButtonInfo}"
                hc:BorderElement.CornerRadius="8"
                Command="{Binding RevealResultsCommand}" 
                CommandParameter="{Binding ElementName=SuperPin}"/>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="VENTA TOTAL" Foreground="Gray" FontWeight="Medium"/>
                            <TextBlock Text="{Binding SystemTotal, StringFormat=C}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="TOTAL FIANZAS" Foreground="#EF6C00" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalFianzas, StringFormat='- {0:C}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#EF6C00"/>
                        </Grid>
                        <Separator Background="#EEEEEE" Margin="0,5"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="DIFERENCIA" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Black" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Difference, StringFormat=C}" HorizontalAlignment="Right" FontSize="22" FontWeight="Black" Foreground="#D32F2F"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <GroupBox Header="LOS 3 MÁS VENDIDOS" hc:TitleElement.TitlePlacement="Top" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding TopProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F5F5F5" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0} Unidades}" 
           HorizontalAlignment="Right" Foreground="Gray" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="CONFIRMAR Y EXPORTAR REPORTE" 
                Command="{Binding FinalizeCommand}"
                Style="{StaticResource ButtonPrimary}" 
                Height="55" FontWeight="ExtraBold" FontSize="14"
                hc:BorderElement.CornerRadius="0"
                Margin="0" />
    </Grid>
</hc:Window>