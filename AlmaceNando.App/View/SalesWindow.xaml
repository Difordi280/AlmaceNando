<UserControl x:Class="AlmaceNando.App.View.SalesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="10" Margin="0,0,10,0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderThickness="0,0,0,1" BorderBrush="#EEEEEE" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="5" Height="20" CornerRadius="2" Background="{DynamicResource SecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Cuentas Activas" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Margin" Value="5,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#F0F0F0" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DockPanel Grid.Row="1" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding User}" FontSize="11" FontStyle="Italic" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Total, StringFormat='${0:N2}'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="0,0,10,0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="15">
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" Height="20" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Productos" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Todo"  Margin="2,0"/>
                            <Button Content="Lácteos"  Margin="2,0"/>
                        </StackPanel>
                    </DockPanel>

                    <hc:SearchBar Style="{StaticResource SearchBarPlus}" 
                                  
                                  Height="35"/>
                </StackPanel>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#EEEEEE"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Products}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <hc:Card Width="140" Height="140" Margin="5"  BorderThickness="0">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="MouseLeftButtonDown">
                                        <hc:EventToCommand Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="5,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat='${0:N2}'}" 
                                               HorizontalAlignment="Center" FontWeight="Bold" 
                                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>

                                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" 
                                            Background="{DynamicResource SecondaryBrush}" CornerRadius="10" Padding="5">
                                        <TextBlock Text="+" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </hc:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="10" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#333333" Padding="15" CornerRadius="10,10,0,0">
                    <DockPanel>
                        <TextBlock Text="CESTA DE COMPRA" Foreground="White" FontWeight="Bold"/>
                        <Button  Foreground="White" HorizontalAlignment="Right" Content="🗑️" 
                                Command="{Binding ClearCartCommand}"/>
                    </DockPanel>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{Binding Cart}" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Text="{Binding Price, StringFormat='${0:N2} x {1} uds'}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='${0:N2}'}" 
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="10,0"/>

                                <Button Grid.Column="2" Content="x" Width="20" Height="20" Padding="0"
                                         
                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Background="#F9F9F9" Margin="10">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='${0:N2}'}" 
                                   DockPanel.Dock="Right" FontWeight="Black" FontSize="20" 
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </DockPanel>

                    <Button Content="PAGAR AHORA" Command="{Binding CheckoutCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            Height="40" Margin="0,0,0,5" BorderThickness="0" />

                    <Button Content="Cargar a Deuda" 
                            Background="{DynamicResource SecondaryBrush}" Foreground="White" 
                            Height="35" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
