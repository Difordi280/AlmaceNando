<UserControl x:Class="AlmaceNando.App.View.SalesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             MouseDown="UserControl_MouseDown">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#DDDDDD" ShadowDepth="5" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="15,10">
                    <Grid>
                        <TextBlock Text="Cuentas" 
                           VerticalAlignment="Center"
                           FontWeight="Bold" 
                           FontSize="14" 
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Button Command="{Binding AddAccountCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ButtonPrimary}"
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        Content="Agregar"
                        Height="30"
                        Padding="10,0"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Account}" SelectedItem="{Binding SelectAccounts}" BorderThickness="0" Background="Transparent" Padding="8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="10" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Table}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="15" Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#DDDDDD" ShadowDepth="5" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="20" Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Productos" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" Foreground="#333"/>
                        <hc:SearchBar x:Name="txtSearch" 
                            Command="{Binding AddFistProductCommand}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                            Style="{StaticResource SearchBarPlus}" 
                            Height="40"/>       
                    </StackPanel>
                </Border>



                <ListBox x:Name="lstProduct" 
                         PreviewMouseDown="lstProduct_PreviewMouseDown"
                         TabIndex="2"
                         KeyboardNavigation.TabNavigation="Continue"          
                         Grid.Row="1" 
                         ItemsSource="{Binding Items}" 
                         SelectedItem="{Binding SelectedProduct}"                          
                         BorderThickness="0" 
                         Background="Transparent"
                         Margin="10,0,10,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyboardNavigation.DirectionalNavigation="Cycle">      

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="OuterBorder" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0">

                                            <Border x:Name="CardBorder" 
                                Width="135" Height="150" Margin="5" 
                                Background="White" CornerRadius="12" 
                                BorderThickness="1.5" BorderBrush="#EEE">
                                                <ContentPresenter />
                                            </Border>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FAFAFA"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#F0F7FF"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2.5"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#E8F5E9"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2ecc71"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" 
                           FontWeight="SemiBold" 
                           TextAlignment="Center" 
                           Margin="5,5,5,0" 
                           TextWrapping="Wrap" 
                           Foreground="Black"/>
                                <TextBlock Text="{Binding Price, StringFormat='${0:N0}'}" 
                           Foreground="#2ecc71" 
                           HorizontalAlignment="Center" 
                           FontWeight="Bold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>




            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#DDDDDD" ShadowDepth="5" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource TextPrimaryBrush}" Padding="15" CornerRadius="15,15,0,0">
                    <DockPanel>
                        <TextBlock Text="CESTA" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <Button Content="Vaciar" Foreground="#FF8A80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Command="{Binding ClearCartCommand}"/>
                    </DockPanel>
                </Border>

                <ListView x:Name="lstCart" TabIndex="3"
                          GotFocus="lstCart_GotFocus"
                          SelectionChanged="lstCart_SelectionChanged"
                          SelectionMode="Single"
                          KeyboardNavigation.DirectionalNavigation="Once"
                          KeyboardNavigation.TabNavigation="Continue"
                          IsSynchronizedWithCurrentItem="False"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          Grid.Row="1" 
                          ItemsSource="{Binding SelectAccounts.Cart}" 
                          Style="{x:Null}" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          Margin="0,5"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">    
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" 
                                Background="White" 
                                CornerRadius="10" 
                                Margin="8,3" 
                                Padding="12,10" 
                                BorderBrush="#F0F0F0" 
                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F9F9F9"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E0E0E0"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F7FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📦" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Price, StringFormat='${0:N0}'}" Foreground="Gray" FontSize="9"/>
                                </StackPanel>

                                <hc:NumericUpDown Grid.Column="2" 
                                                  x:Name="numQty"
                                                  Focusable="True"
                                  Value="{Binding Quantity}" 
                                  Minimum="1" Maximum="99"
                                  Width="58" Height="25" 
                                  FontSize="11" 
                                  VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat='${0:N0}'}" 
                           FontWeight="Black" 
                           TextAlignment="Right" 
                           VerticalAlignment="Center" 
                           FontSize="11" 
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="5,0"/>

                                <Button Grid.Column="4" Content="🗑️" FontSize="12" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#E74C3C" VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FDECEA"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2" Background="#F9F9F9" Padding="15" CornerRadius="0,0,15,15">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="TOTAL" Foreground="Gray" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectAccounts.GrandTotal, StringFormat='${0:N2}'}" DockPanel.Dock="Right" FontWeight="Black" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <Button Content="PAGAR AHORA" Background="{DynamicResource PrimaryBrush}" Command="{Binding ProccessSaleCommand}" Foreground="White" Height="45" FontWeight="Bold" hc:BorderElement.CornerRadius="10" Margin="0,0,0,8"/>
                        <Button Content="Cargar a Deuda" Background="White" Foreground="{DynamicResource SecondaryBrush}" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1" Height="40" hc:BorderElement.CornerRadius="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>